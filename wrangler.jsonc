{
  // Configuration Cloudflare du POC Répétition, utilisable depuis la RACINE du dépôt (équivalent de poc/wrangler.jsonc).
  "name": "ai-interview-platform",
  "main": "poc/server/hosts/cloudflare.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./poc/public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  // Production : base D1 créée automatiquement au premier déploiement.
  "d1_databases": [{ "binding": "DB", "database_name": "ai-interview-poc" }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Conserver les variables saisies dans le tableau de bord Cloudflare lors des déploiements.
  "keep_vars": true,
  // Voix et dictée ElevenLabs. La clé se saisit comme SECRET (jamais ici) : ELEVENLABS_API_KEY.
  // Sans clé, la plateforme reprend automatiquement la voix et la dictée du navigateur.
  "vars": { "TTS_PROVIDER": "elevenlabs", "STT_PROVIDER": "elevenlabs" },
  // Préversions (branches hors production) : sans base, en mode démo et voix du navigateur.
  "previews": {
    "ai": { "binding": "AI" }
  }
}
