# ---- Configuration du serveur Répétition (hôte Node.js / Docker) ----
# Ne jamais versionner le fichier .env réel.

# Base de données : SQLite par défaut ; PostgreSQL si DATABASE_URL est défini.
# STORE=sqlite|postgres
# SQLITE_PATH=./data/app.db
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# PG_SCHEMA=app                 # schéma dédié, séparé de question_bank et public
# PG_SSL=require|disable        # détecté automatiquement pour Supabase, Neon, Azure, RDS
# POSTGRES_PASSWORD=            # utilisé par docker-compose uniquement

# IA (facultative) : none | openai | anthropic | workers-ai (Cloudflare) | auto
# AI_PROVIDER=none
# AI_BASE_URL=https://api.openai.com/v1   # ou Mistral, Groq, OpenRouter, Ollama (http://localhost:11434/v1)…
# AI_API_KEY=
# AI_MODEL=

# Transcription vocale : browser (dictée du navigateur) | kyutai
# STT_PROVIDER=browser
# KYUTAI_STT_URL=wss://stt.exemple.ma      # moshi-server Kyutai (GPU), derrière un proxy TLS
# KYUTAI_STT_API_KEY=                      # jeton défini dans authorized_ids du serveur Kyutai (secret)

# Inscription des coachs : fermée tant que cette valeur n'est pas définie (longue et aléatoire).
# COACH_INVITE_CODE=

# Réseau
# PORT=8080
# HOST=0.0.0.0
# PUBLIC_URL=https://entretien.exemple.ma   # recommandé en production (cookies Secure, contrôle d'origine)
# TRUST_PROXY=true                           # derrière un proxy (Nginx, Traefik, load balancer)
# COOKIE_SECURE=true
