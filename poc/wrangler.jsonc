{
  // Hôte Cloudflare Workers du POC Répétition. Répertoire racine du build Cloudflare : poc
  "name": "ai-interview-poc",
  "main": "server/hosts/cloudflare.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Base D1 créée automatiquement au premier déploiement (provisionnement automatique de Wrangler).
  "d1_databases": [{ "binding": "DB", "database_name": "ai-interview-poc" }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
