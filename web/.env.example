# Public Supabase credentials for browser authentication (never service_role).
# Copy this file to .env.local and fill values from your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # legacy alternative if required

# Sentry error monitoring (no candidate content or session replay)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional for production sourcemaps in CI: SENTRY_AUTH_TOKEN=
