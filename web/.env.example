# Public Supabase credentials for browser authentication (never service_role).
# Copy this file to .env.local and fill values from your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # legacy alternative if required

# Sentry error monitoring (no candidate content or session replay)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional for production sourcemaps in CI: SENTRY_AUTH_TOKEN=

# Simulateur d'entretien et voix de Lina (pont serveur de l'application)
# Local (Mac d'Achraf) : laboratoire Python sur 127.0.0.1:8765 par défaut, rien à régler. Pour un autre serveur :
# LAB_UPSTREAM_URL=http://127.0.0.1:8765
# Secret partagé avec le Worker ai-interview-platform (≥ 24 caractères, identique des deux côtés). Sur Cloudflare : secret du Worker.
# BRIDGE_SECRET=

